# Personal Claude Code settings (the shared hooks live in .claude/settings.json)
.claude/settings.local.json

# Local secrets. Keys live in .env.local or the Vercel dashboard, never in git or in chat,
# because every prompt is logged verbatim to .agent-logs/, which is public.
.env*
!.env.example

# Local state of the gstack headless browser (research and QA runs)
.gstack/

# Dependencies and build output (from create-next-app)
/node_modules
/.next/
/out/
/build
/coverage
.vercel
*.tsbuildinfo
next-env.d.ts
.DS_Store
*.pem
npm-debug.log*

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
