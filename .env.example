# Copy to .env.local and fill in. Never commit real values, and never paste them into chat:
# every prompt is logged verbatim to the public .agent-logs/ (AGENTS.md §11).

# fake: in-process fakes for the LLM, media, storage, rate limiting and email (no keys, no spend).
# real: the providers below.
PROVIDERS=fake

# Required in every mode.
DATABASE_URL=
BETTER_AUTH_SECRET=

# Migrations (direct, unpooled) and the integration-test branch.
DATABASE_URL_UNPOOLED=
DATABASE_URL_TEST=

NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Caps and the kill-switch (defaults shown).
GUEST_VIDEO_CAP=6
USER_VIDEO_CAP=18
DAILY_SPEND_CAP_USD=10

# Required when PROVIDERS=real.
OPENAI_API_KEY=
DIRECTOR_MODEL=gpt-6-sol
FAL_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Vercel Blob (ADR-023): set by connecting a Blob store to the Vercel project. Either is enough;
# the store id authenticates with Vercel's OIDC token, so it only works on Vercel.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAGIC_LINK_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
